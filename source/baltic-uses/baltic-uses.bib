	author = {Oude Munnink, Bas B. and Nieuwenhuijse, David F. and Stein, Mart and O’Toole, Áine and Haverkate, Manon and Mollers, Madelief and Kamga, Sandra K. and Schapendonk, Claudia and Pronk, Mark and Lexmond, Pascal and van der Linden, Anne and Bestebroer, Theo and Chestakova, Irina and Overmars, Ronald J. and van Nieuwkoop, Stefan and Molenkamp, Richard and van der Eijk, Annemiek A. and GeurtsvanKessel, Corine and Vennema, Harry and Meijer, Adam and Rambaut, Andrew and van Dissel, Jaap and Sikkema, Reina S. and Timen, Aura and Koopmans, Marion},
	month = sep,
	year = {2020},
	note = {Number: 9},
	keywords = {Molecular biology, Genomics, Respiratory tract diseases},
	pages = {1405--1410},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\UYAE5DLT\\Oude Munnink et al. - 2020 - Rapid SARS-CoV-2 whole-genome sequencing and analy.pdf:application/pdf;Snapshot:C\:\\Users\\evogytis\\Zotero\\storage\\WG3PURSB\\s41591-020-0997-y.html:text/html},
}

