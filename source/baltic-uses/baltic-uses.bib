	month = nov,
	year = {2023},
	pages = {595--600},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\4G3GHS6T\\O’Toole et al. - 2023 - APOBEC3 deaminase editing in mpox virus as evidenc.pdf:application/pdf},
