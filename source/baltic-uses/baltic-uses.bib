	keywords = {phylogeny, Chioneinae, COI, integrative taxonomy, larva, mtDNA, new genus, new species, pupa},
	pages = {988},
	file = {Full Text:C\:\\Users\\evogytis\\Zotero\\storage\\NWKSAMVN\\Podenas et al. - 2023 - A New Genus and Two New Species of Short-Palped Crane Flies (Diptera Limoniidae) from Central Asia.pdf:application/pdf;Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\ISA7EUJF\\Podenas et al. - 2023 - A New Genus and Two New Species of Short-Palped Crane Flies (Diptera Limoniidae) from Central Asia.pdf:application/pdf},
