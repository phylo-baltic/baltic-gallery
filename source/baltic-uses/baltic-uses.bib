@article{normandin_high-depth_2023,
	title = {High-depth sequencing characterization of viral dynamics across tissues in fatal {COVID}-19 reveals compartmentalized infection},
	volume = {14},
	copyright = {2023 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-022-34256-y},
	doi = {10.1038/s41467-022-34256-y},
	abstract = {SARS-CoV-2 distribution and circulation dynamics are not well understood due to challenges in assessing genomic data from tissue samples. We develop experimental and computational workflows for high-depth viral sequencing and high-resolution genomic analyses from formalin-fixed, paraffin-embedded tissues and apply them to 120 specimens from six subjects with fatal COVID-19. To varying degrees, viral RNA is present in extrapulmonary tissues from all subjects. The majority of the 180 viral variants identified within subjects are unique to individual tissue samples. We find more high-frequency ({\textgreater}10\%) minor variants in subjects with a longer disease course, with one subject harboring ten such variants, exclusively in extrapulmonary tissues. One tissue-specific high-frequency variant was a nonsynonymous mutation in the furin-cleavage site of the spike protein. Our findings suggest adaptation and/or compartmentalized infection, illuminating the basis of extrapulmonary COVID-19 symptoms and potential for viral reservoirs, and have broad utility for investigating human pathogens.},
	language = {en},
	number = {1},
	urldate = {2023-02-07},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Normandin, Erica and Rudy, Melissa and Barkas, Nikolaos and Schaffner, Stephen F. and Levine, Zoe and Padera, Robert F. and Babadi, Mehrtash and Mukerji, Shibani S. and Park, Daniel J. and MacInnis, Bronwyn L. and Siddle, Katherine J. and Sabeti, Pardis C. and Solomon, Isaac H.},
	month = feb,
	year = {2023},
	note = {Number: 1},
	keywords = {SARS-CoV-2, Infection, Viral genetics},
	pages = {574},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\5V5A8VXN\\Normandin et al. - 2023 - High-depth sequencing characterization of viral dy.pdf:application/pdf},
}

