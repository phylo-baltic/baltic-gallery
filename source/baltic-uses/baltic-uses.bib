@article{braun_acute_2021,
	title = {Acute {SARS}-{CoV}-2 infections harbor limited within-host diversity and transmit via tight transmission bottlenecks},
	volume = {17},
	issn = {1553-7374},
	url = {https://journals.plos.org/plospathogens/article?id=10.1371/journal.ppat.1009849},
	doi = {10.1371/journal.ppat.1009849},
	abstract = {The emergence of divergent SARS-CoV-2 lineages has raised concern that novel variants eliciting immune escape or the ability to displace circulating lineages could emerge within individual hosts. Though growing evidence suggests that novel variants arise during prolonged infections, most infections are acute. Understanding how efficiently variants emerge and transmit among acutely-infected hosts is therefore critical for predicting the pace of long-term SARS-CoV-2 evolution. To characterize how within-host diversity is generated and propagated, we combine extensive laboratory and bioinformatic controls with metrics of within- and between-host diversity to 133 SARS-CoV-2 genomes from acutely-infected individuals. We find that within-host diversity is low and transmission bottlenecks are narrow, with very few viruses founding most infections. Within-host variants are rarely transmitted, even among individuals within the same household, and are rarely detected along phylogenetically linked infections in the broader community. These findings suggest that most variation generated within-host is lost during transmission.},
	language = {en},
	number = {8},
	urldate = {2022-03-31},
	journal = {PLOS Pathogens},
	publisher = {Public Library of Science},
	author = {Braun, Katarina M. and Moreno, Gage K. and Wagner, Cassia and Accola, Molly A. and Rehrauer, William M. and Baker, David A. and Koelle, Katia and O’Connor, David H. and Bedford, Trevor and Friedrich, Thomas C. and Moncla, Louise H.},
	month = aug,
	year = {2021},
	keywords = {Phylogenetic analysis, Phylogenetics, Genomics, Viral evolution, Respiratory infections, SARS CoV 2, Bioinformatics, Evolutionary immunology},
	pages = {e1009849},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\3K3IHQSR\\Braun et al. - 2021 - Acute SARS-CoV-2 infections harbor limited within-.pdf:application/pdf;Snapshot:C\:\\Users\\evogytis\\Zotero\\storage\\SGM46N9P\\article.html:text/html},
}

@article{bell_modern-day_2017,
	title = {Modern-day {SIV} viral diversity generated by extensive recombination and cross-species transmission},
	volume = {13},
	issn = {1553-7374},
	url = {https://journals.plos.org/plospathogens/article?id=10.1371/journal.ppat.1006466},
	doi = {10.1371/journal.ppat.1006466},
	abstract = {Cross-species transmission (CST) has led to many devastating epidemics, but is still a poorly understood phenomenon. HIV-1 and HIV-2 (human immunodeficiency virus 1 and 2), which have collectively caused over 35 million deaths, are the result of multiple CSTs from chimpanzees, gorillas, and sooty mangabeys. While the immediate history of HIV is known, there are over 45 lentiviruses that infect specific species of primates, and patterns of host switching are not well characterized. We thus took a phylogenetic approach to better understand the natural history of SIV recombination and CST. We modeled host species as a discrete character trait on the viral phylogeny and inferred historical host switches and the pairwise transmission rates between each pair of 24 primate hosts. We identify 14 novel, well-supported, ancient cross-species transmission events. We also find that lentiviral lineages vary widely in their ability to infect new host species: SIVcol (from colobus monkeys) is evolutionarily isolated, while SIVagms (from African green monkeys) frequently move between host subspecies. We also examine the origins of SIVcpz (the predecessor of HIV-1) in greater detail than previous studies, and find that there are still large portions of the genome with unknown origins. Observed patterns of CST are likely driven by a combination of ecological circumstance and innate immune factors.},
	language = {en},
	number = {7},
	urldate = {2022-03-31},
	journal = {PLOS Pathogens},
	publisher = {Public Library of Science},
	author = {Bell, Sidney M. and Bedford, Trevor},
	month = jul,
	year = {2017},
	keywords = {Sequence alignment, Phylogenetic analysis, Viral evolution, Animal phylogenetics, Mammalian genomics, Monkeys, Primates, SIV},
	pages = {e1006466},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\BNKAF8MY\\Bell and Bedford - 2017 - Modern-day SIV viral diversity generated by extens.pdf:application/pdf;Snapshot:C\:\\Users\\evogytis\\Zotero\\storage\\6AS5VMNE\\article.html:text/html},
}

