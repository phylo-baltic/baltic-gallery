@article{butera_genomic_2024,
	title = {Genomic and transmission dynamics of the 2024 {Marburg} {Virus} {Outbreak} in {Rwanda}},
	copyright = {2024 The Author(s), under exclusive licence to Springer Nature America, Inc.},
	issn = {1546-170X},
	url = {https://www.nature.com/articles/s41591-024-03459-9},
	doi = {10.1038/s41591-024-03459-9},
	abstract = {The ongoing outbreak of Marburg virus disease (MVD) in Rwanda marks the third largest historically, though it has exhibited the lowest fatality rate. Genomic analysis of samples from 18 cases identified a lineage with limited internal diversity, closely related to a 2014 Ugandan case. Our findings suggest that the Rwandan lineage diverged decades ago from a common ancestor shared with diversity sampled from bats in Uganda. Our genomic data reveals limited genetic variation, consistent with single zoonotic transmission event and limited human-to-human transmission. Investigations including contact tracing, clinical assessments, sequencing and serology, linked the index case to a mining cave inhabited by Rousettus aegyptiacus. Serology tests identified three individuals seropositive for IgG and IgM, further supporting the zoonotic origin of the outbreak through human-animal interactions.},
	language = {en},
	urldate = {2024-12-17},
	journal = {Nature Medicine},
	publisher = {Nature Publishing Group},
	author = {Butera, Yvan and Mutesa, Leon and Parker, Edyth and Muvunyi, Raissa and Umumararungu, Esperance and Ayitewala, Alisen and Musabyimana, Jean Pierre and Olono, Alhaji and Sesonga, Placide and Ogunsanya, Olusola and Kabalisa, Emmanuel and Adedokun, Oluwatobi and Gahima, Nelson and Irankunda, Laetitia and Mutezemariya, Chantal and Niyonkuru, Richard and Uwituze, Arlene and Uwizera, Ithiel and Kagame, James and Umugwaneza, Arlette and Rwabuhihi, John and Umwanankabandi, Fidele and Mbonitegeka, Valens and Ntagwabira, Edouard and Kayigi, Etienne and Izuwayo, Gerard and Murenzi, Herve and Mukankwiro, Therese and Tuyiringire, Nasson and Uwimana, Jean Marie Vianney and Gasengayire, Agnes and Sindayiheba, Reuben and Onyeugo, Glory-Ugochi and Aragaw, Merawi and Gitundu, Lenny and Bigirimana, Radjabu and Fallah, Mosoka and Ejikeme, Adaora and Sembuche, Senga and Kabanda, Alice and Mugisha, Jean Claude and Francis, Emmanuel Edwar Siddig and Gashema, Pierre and Ndayisenga, Jerome and Rugamba, Alexis and Kanyabwisha, Faustin and Murenzi, Gad and Happi, Anise and Ngabonziza, Jean Claude Semuto and Gashegu, Misbah and Ahmed, Ayman and Bigirimana, Noella and Rwagasore, Edson and Semakula, Muhammed and Rwabihama, Jean Paul and Musanabaganwa, Clarisse and Seruyange, Eric and Nkeshimana, Menelas and Twagirumugabe, Theogene and Turatsinze, David and Remera, Eric and Gahamanyi, Noel and Tessema, Sofonias Kifle and Mukagatare, Isabelle and Nsanzimana, Sabin and Happi, Christian and Muvunyi, Claude Mambo},
