@article{podenas_new_2023,
	title = {A {New} {Genus} and {Two} {New} {Species} of {Short}-{Palped} {Crane} {Flies} ({Diptera}: {Limoniidae}) from {Central} {Asia}},
	volume = {15},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
