@article{alpert_early_2021,
	title = {Early introductions and transmission of {SARS}-{CoV}-2 variant {B}.1.1.7 in the {United} {States}},
	volume = {184},
	issn = {0092-8674},
	url = {https://www.sciencedirect.com/science/article/pii/S0092867421004347},
	doi = {10.1016/j.cell.2021.03.061},
	abstract = {The emergence and spread of SARS-CoV-2 lineage B.1.1.7, first detected in the United Kingdom, has become a global public health concern because of its increased transmissibility. Over 2,500 COVID-19 cases associated with this variant have been detected in the United States (US) since December 2020, but the extent of establishment is relatively unknown. Using travel, genomic, and diagnostic data, we highlight that the primary ports of entry for B.1.1.7 in the US were in New York, California, and Florida. Furthermore, we found evidence for many independent B.1.1.7 establishments starting in early December 2020, followed by interstate spread by the end of the month. Finally, we project that B.1.1.7 will be the dominant lineage in many states by mid- to late March. Thus, genomic surveillance for B.1.1.7 and other variants urgently needs to be enhanced to better inform the public health response.},
	language = {en},
	number = {10},
	urldate = {2022-03-31},
	journal = {Cell},
	author = {Alpert, Tara and Brito, Anderson F. and Lasek-Nesselquist, Erica and Rothman, Jessica and Valesano, Andrew L. and MacKay, Matthew J. and Petrone, Mary E. and Breban, Mallery I. and Watkins, Anne E. and Vogels, Chantal B. F. and Kalinich, Chaney C. and Dellicour, Simon and Russell, Alexis and Kelly, John P. and Shudt, Matthew and Plitnick, Jonathan and Schneider, Erasmus and Fitzsimmons, William J. and Khullar, Gaurav and Metti, Jessica and Dudley, Joel T. and Nash, Megan and Beaubier, Nike and Wang, Jianhui and Liu, Chen and Hui, Pei and Muyombwe, Anthony and Downing, Randy and Razeq, Jafar and Bart, Stephen M. and Grills, Ardath and Morrison, Stephanie M. and Murphy, Steven and Neal, Caleb and Laszlo, Eva and Rennert, Hanna and Cushing, Melissa and Westblade, Lars and Velu, Priya and Craney, Arryn and Cong, Lin and Peaper, David R. and Landry, Marie L. and Cook, Peter W. and Fauver, Joseph R. and Mason, Christopher E. and Lauring, Adam S. and St. George, Kirsten and MacCannell, Duncan R. and Grubaugh, Nathan D.},
	month = may,
	year = {2021},
	keywords = {SARS-CoV-2, epidemiology, lineage, phylogenetics, variant, B.1.1.7, community transmission, flight volumes, genomic surveillance, introductions},
	pages = {2595--2604.e13},
	file = {Full Text:C\:\\Users\\evogytis\\Zotero\\storage\\U8R6MVNX\\Alpert et al. - 2021 - Early introductions and transmission of SARS-CoV-2.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\evogytis\\Zotero\\storage\\VHSWFPM9\\S0092867421004347.html:text/html},
