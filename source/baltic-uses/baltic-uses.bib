	author = {Sage, Valerie Le and Vu, Michelle N. and Maltepes, Maria A. and Wang, Shengyang and Snow, Brooke A. and Merrbach, Grace A. and Benton, Alexandra J. and Zirckel, Kylie E. and Petnuch, Sarah E. and Marble, Carly N. and Rigatti, Lora H. and Paulson, James C. and Drapeau, Elizabeth M. and McElroy, Anita K. and Hensley, Scott E. and Moncla, Louise H. and Lakdawala, Seema S.},
	month = mar,
	year = {2026},
	keywords = {Influenza A virus, Antibodies, Ferrets, Respiratory infections, Viral replication, Influenza viruses, Pandemics, Immunity},
	pages = {e1013586},
