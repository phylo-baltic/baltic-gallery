@article{graf_phylogenetic-based_2022,
	title = {Phylogenetic-based inference reveals distinct transmission dynamics of {SARS}-{CoV}-2 lineages {Gamma} and {P}.2 in {Brazil}},
	volume = {25},
	issn = {2589-0042},
	url = {https://www.sciencedirect.com/science/article/pii/S2589004222004266},
	doi = {10.1016/j.isci.2022.104156},
	abstract = {The COVID-19 epidemic in Brazil experienced two major lineage replacements until mid-2021. The first was driven by lineage P.2, in late 2020, and the second by lineage Gamma, in early 2021. To understand how these SARS-CoV-2 lineages spread in Brazil, we analyzed 11,724 genomes collected throughout the country between September 2020 and April 2021. Our findings indicate that lineage P.2 probably emerged in July 2020 in the Rio de Janeiro state and Gamma in November 2020 in the Amazonas state. Both states were the main hubs of viral disseminations to other Brazilian locations. We estimate that Gamma was 1.56–3.06 times more transmissible than P.2 in Rio de Janeiro and that the median effective reproductive number (Re) of Gamma varied according to the geographic context (Re = 1.59–3.55). In summary, our findings support that lineage Gamma was more transmissible and spread faster than P.2 in Brazil.},
	language = {en},
	number = {4},
	urldate = {2022-05-11},
	journal = {iScience},
	author = {Gräf, Tiago and Bello, Gonzalo and Naveca, Felipe Gomes and Gomes, Marcelo and Cardoso, Vanessa Leiko Oikawa and da Silva, Alexandre Freitas and Dezordi, Filipe Zimmer and dos Santos, Mirleide Cordeiro and Santos, Katia Correa de Oliveira and Batista, Érika Lopes Rocha and Magalhães, Alessandro Leonardo Álvares and Vinhal, Fernando and Miyajima, Fábio and Faoro, Helisson and Khouri, Ricardo and Wallau, Gabriel Luz and Delatorre, Edson and Siqueira, Marilda Mendonça and Resende, Paola Cristina and Mattos, Tirza Peixoto and Nascimento, Valdinete Alves and Souza, Victor and Corado, André de Lima Guerra and Nascimento, Fernanda and Silva, George and Mejía, Matilde and Brandão, Maria Júlia and Costa, Ágatha and Pessoa, Karina and Jesus, Michele and Gonçalves, Luciana Fé and Fernandes, Cristiano and Andrade, Valnete and Barbagelata, Luana and Cruz, Ana Cecília Ribeiro and Costa, Andrea and Silva, Lindomar dos Anjos and Galvão, Jucimária Dantas and Leite, Anderson Brandao and Pereira, Felicidade Mota and Costa, Thais Oliveira and Sousa, Joaquim Cesar and Neto, Lidio Gonçalves Lima and Barroso, Haline and Teixeira, Dalane Loudal Florentino and Bezerra, Joao Felipe and Docena, Cássia and de Lima, Raul Emídio and Silva, Lilian Caroliny Amorim and de Lima, Gustavo Barbosa and Machado, Laís Ceschini and Bezerra, Matheus Filgueira and Paiva, Marcelo Henrique Santos and Dantas, Maria Eduarda Pessoa Lopes and Pereira, Raíssa Liane Do Nascimento and Araújo, Josélio and Santos, Cliomar A. and Ribeiro-Rodrigues, Rodrigo and Bernardes, André Felipe Leal and Iani, Felipe Campos de Melo and Grinsztejn, Beatriz and Veloso, Valdiléa G. and Brasil, Patricia and da Paixão, Anna Carolina Dias and Appolinario, Luciana Reis and Lopes, Renata Serrano and Motta, Fernando do Couto and Rocha, Alice Sampaio and Venas, Taina Moreira Martins and Pereira, Elisa Cavalcante and Cavalcanti, Andrea Cony and Bastos, Leonardo Soares and Brigido, Luis Fernando de Macedo and Oliveira, Mauro de Mede