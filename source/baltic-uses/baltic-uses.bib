@article{washington_emergence_2021,
	title = {Emergence and rapid transmission of {SARS}-{CoV}-2 {B}.1.1.7 in the {United} {States}},
	volume = {184},
	issn = {0092-8674},
	url = {https://www.sciencedirect.com/science/article/pii/S0092867421003834},
	doi = {10.1016/j.cell.2021.03.052},
	abstract = {The highly transmissible B.1.1.7 variant of SARS-CoV-2, first identified in the United Kingdom, has gained a foothold across the world. Using S gene target failure (SGTF) and SARS-CoV-2 genomic sequencing, we investigated the prevalence and dynamics of this variant in the United States (US), tracking it back to its early emergence. We found that, while the fraction of B.1.1.7 varied by state, the variant increased at a logistic rate with a roughly weekly doubling rate and an increased transmission of 40\%–50\%. We revealed several independent introductions of B.1.1.7 into the US as early as late November 2020, with community transmission spreading it to most states within months. We show that the US is on a similar trajectory as other countries where B.1.1.7 became dominant, requiring immediate and decisive action to minimize COVID-19 morbidity and mortality.},
	language = {en},
	number = {10},
	urldate = {2022-03-31},
	journal = {Cell},
	author = {Washington, Nicole L. and Gangavarapu, Karthik and Zeller, Mark and Bolze, Alexandre and Cirulli, Elizabeth T. and Schiabor Barrett, Kelly M. and Larsen, Brendan B. and Anderson, Catelyn and White, Simon and Cassens, Tyler and Jacobs, Sharoni and Levan, Geraint and Nguyen, Jason and Ramirez, Jimmy M. and Rivera-Garcia, Charlotte and Sandoval, Efren and Wang, Xueqing and Wong, David and Spencer, Emily and Robles-Sikisaka, Refugio and Kurzban, Ezra and Hughes, Laura D. and Deng, Xianding and Wang, Candace and Servellita, Venice and Valentine, Holly and De Hoff, Peter and Seaver, Phoebe and Sathe, Shashank and Gietzen, Kimberly and Sickler, Brad and Antico, Jay and Hoon, Kelly and Liu, Jingtao and Harding, Aaron and Bakhtar, Omid and Basler, Tracy and Austin, Brett and MacCannell, Duncan and Isaksson, Magnus and Febbo, Phillip G. and Becker, David and Laurent, Marc and McDonald, Eric and Yeo, Gene W. and Knight, Rob and Laurent, Louise C. and de Feo, Eileen and Worobey, Michael and Chiu, Charles Y. and Suchard, Marc A. and Lu, James T. and Lee, William and Andersen, Kristian G.},
