@article{jansen_van_vuren_phylodynamic_2019,
	title = {Phylodynamic {Analysis} of {Ebola} {Virus} {Disease} {Transmission} in {Sierra} {Leone}},
	volume = {11},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {1999-4915},
	url = {https://www.mdpi.com/1999-4915/11/1/71},
	doi = {10.3390/v11010071},
	abstract = {We generated genome sequences from 218 cases of Ebola virus disease (EVD) in Sierra Leone (SLE) during 2014–2015 to complement available datasets, particularly by including cases from a period of low sequence coverage during peak transmission of Ebola virus (EBOV) in the highly-affected Western Area division of SLE. The combined dataset was utilized to produce phylogenetic and phylodynamic inferences, to study sink–source dynamics and virus dispersal from highly-populated transmission hotspots. We identified four districts in SLE where EBOV was introduced and transmission occurred without onward exportation to other districts. We also identified six districts that substantially contributed to the dispersal of the virus and prolonged the EVD outbreak: five of these served as major hubs, with lots of movement in and out, and one acted primarily as a source, exporting the virus to other areas of the country. Positive correlations between case numbers, inter-district transition events, and district population sizes reaffirm that population size was a driver of EBOV transmission dynamics in SLE. The data presented here confirm the role of urban hubs in virus dispersal and of a delayed laboratory response in the expansion and perpetuation of the EVD outbreak in SLE.},
	language = {en},
	number = {1},
	urldate = {2022-03-31},
	journal = {Viruses},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Jansen van Vuren, Petrus and Ladner, Jason T. and Grobbelaar, Antoinette A. and Wiley, Michael R. and Lovett, Sean and Allam, Mushal and Ismail, Arshad and le Roux, Chantel and Weyer, Jacqueline and Moolla, Naazneen and Storm, Nadia and Kgaladi, Joe and Sanchez-Lockhart, Mariano and Conteh, Ousman and Palacios, Gustavo and Paweska, Janusz T.},
	month = jan,
	year = {2019},
	note = {Number: 1},
	keywords = {Ebola virus, Sierra Leone, phylodynamics, \textit{Filoviridae}, Ebola virus disease, filovirus, West Africa},
	pages = {71},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\D3K979K2\\Jansen van Vuren et al. - 2019 - Phylodynamic Analysis of Ebola Virus Disease Trans.pdf:application/pdf;Snapshot:C\:\\Users\\evogytis\\Zotero\\storage\\WBEMIL6X\\71.html:text/html},
}

@article{bell_dengue_2019,
	title = {Dengue genetic divergence generates within-serotype antigenic variation, but serotypes dominate evolutionary dynamics},
	volume = {8},
	issn = {2050-084X},
	url = {https://doi.org/10.7554/eLife.42496},
	doi = {10.7554/eLife.42496},
	abstract = {Dengue virus (DENV) exists as four genetically distinct serotypes, each of which is historically assumed to be antigenically uniform. Recent analyses suggest that antigenic heterogeneity may exist within each serotype, but its source, extent and impact remain unclear. Here, we construct a sequence-based model to directly map antigenic change to underlying genetic divergence. We identify 49 specific substitutions and four colinear substitution clusters that robustly predict dengue antigenic relationships. We report moderate antigenic diversity within each serotype, resulting in genotype-specific patterns of heterotypic cross-neutralization. We also quantify the impact of antigenic variation on real-world DENV population dynamics, and find that serotype-level antigenic fitness is a dominant driver of dengue clade turnover. These results provide a more nuanced understanding of the relationship between dengue genetic and antigenic evolution, and quantify the effect of antigenic fitness on dengue evolutionary dynamics.},
	urldate = {2022-03-31},
	journal = {eLife},
	publisher = {eLife Sciences Publications, Ltd},
	author = {Bell, Sidney M and Katzelnick, Leah and Bedford, Trevor},
	editor = {Ferguson, Neil M and Tautz, Diethard and Lourenço, José},
	month = aug,
	year = {2019},
	keywords = {antigenic evolution, dengue, viral fitness},
	pages = {e42496},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\E7FHTPBF\\Bell et al. - 2019 - Dengue genetic divergence generates within-serotyp.pdf:application/pdf},
}

@article{poen_co-circulation_2019,
