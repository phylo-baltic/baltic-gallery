@article{weber_receptor_2026,
	title = {The receptor binding properties of {H5Ny} influenza {A} viruses have evolved to bind to avian-type mucin-like {O}-glycans},
	volume = {22},
	issn = {1553-7374},
	url = {https://journals.plos.org/plospathogens/article?id=10.1371/journal.ppat.1013812},
	doi = {10.1371/journal.ppat.1013812},
	abstract = {Highly pathogenic H5Ny influenza A viruses are causing unprecedented, season-independent outbreaks across avian and mammalian species, including dairy cattle, a novel reservoir. The sialoside-binding properties of influenza A hemagglutinin (HA) are strongly related to its ability to infect and transmit between hosts. Mucin-like O-glycans, omnipresent in respiratory tracts, have been understudied as viral receptors due to their complexity. To address this, we synthesized 25 O-linked glycans with diverse sialosides, including modifications by fucosides and sulfates. Our findings reveal that H5Ny 2.3.4.4b viruses bind core 3 sialyl-Lewisx and Sia-Gal-β3GalNAc, O-linked glycans not recognized by classical H5 or other avian viruses. By determining crystal structures, we resolved the structural features of four glycans in an H5 hemagglutinin (HA) from a 2016 2.3.4.4b virus. While these viruses do not bind human-type receptors, their broad receptor specificity enhances binding to human tracheal tissues, suggesting that O-glycan recognition could contribute to the continues spillover of this clade.},
	language = {en},
	number = {1},
	urldate = {2026-02-17},
	journal = {PLOS Pathogens},
	publisher = {Public Library of Science},
	author = {Weber, Julia and Ponse, Niels L. D. and Zhu, Xueyong and Carrasco, María Ríos and Han, Alvin X. and Funk, Mathis and Lin, Ting-Hui and García, Alba Gabarroca and Spruit, Cindy M. and Zhang, Ding and Yu, Wenli and Wilson, Ian A. and Richard, Mathilde and Boons, Geert-Jan and Vries, Robert P. de},
	month = jan,
	year = {2026},
	keywords = {Influenza A virus, H5N1, Crystal structure, Viral structure, Binding analysis, Microarrays, Trachea, Viral core},
	pages = {e1013812},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\QDM2YM9V\\Weber et al. - 2026 - The receptor binding properties of H5Ny influenza A viruses have evolved to bind to avian-type mucin.pdf:application/pdf},
}

@article{jasnauskaite_structure_2026,
	title = {Structure and mechanism of antiphage retron {Eco2}},
	volume = {33},
	copyright = {2026 The Author(s)},
	issn = {1545-9985},
	url = {https://www.nature.com/articles/s41594-026-01754-2},
	doi = {10.1038/s41594-026-01754-2},
	abstract = {Retrons are prokaryotic reverse transcriptase systems that produce multicopy single-stranded DNA (msDNA), yet the principles by which they mediate antiviral defense remain largely unresolved. Here we investigate the mechanism of Escherichia coli Eco2, a minimal retron composed of a single reverse transcriptase–nuclease fusion protein. Cryogenic electron microscopy and hydrogen/deuterium exchange mass spectrometry reveal the structures and dynamics of a trimeric nucleoprotein complex assembled within a branched msDNA scaffold, which cages the TOPRIM nucleases. We show that the phage-encoded endonuclease DenB initiates msDNA degradation, thereby unblocking the nuclease active sites. Activated Eco2 cuts transfer RNAs, resulting in translational shutdown for antiphage defense. We further identify ribosomal protein S1 as a putative RNA chaperone that associates with the msDNA precursor. These findings provide insights into the molecular mechanisms of minimal retrons and establish a structural basis for engineering of Eco2.},
	language = {en},
	number = {2},
	urldate = {2026-02-21},
	journal = {Nature Structural \& Molecular Biology},
	publisher = {Nature Publishing Group},
	author = {Jasnauskaitė, M. and Juozapaitis, J. and Liegutė, T. and Grigaitis, R. and Skorupskaitė, A. and Steinchen, W. and Mikšys, A. and Truncaitė, L. and Kazlauskaitė, K. and Torres Jiménez, M. F. and Khochare, S. and Dudas, G. and Bange, G. and Malinauskaitė, L. and Songailienė, I. and Pausch, P.},
	month = feb,
	year = {2026},
	keywords = {Cryoelectron microscopy, Enzyme mechanisms, Phage biology, tRNAs},
	pages = {330--340},
	file = {Full Text PDF:C\:\\Users\\evogytis\\Zotero\\storage\\9MZDDIWK\\Jasnauskaitė et al. - 2026 - Structure and mechanism of antiphage retron Eco2.pdf:application/pdf},
}

@article{mboowa_multicountry_2026,
	title = {Multicountry genomic analysis underscores regional cholera spread in {Africa}},
	volume = {17},
	copyright = {2026 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-026-68642-7},
	doi = {10.1038/s41467-026-68642-7},
	abstract = {Cholera remains a significant public health burden in many countries in sub-Saharan Africa, though the exact mechanisms of bacterial emergence and spread remain largely undefined. We generated genomic data from 763 Vibrio cholerae O1 isolates predominantly collected between 2019-2024 to create the largest dataset of V. cholerae genomes sequenced locally in Africa. This dataset enabled us to interrogate recent patterns of spread, including the rapid circulation of the AFR15 lineage associated with unusually large outbreaks in Southern Africa. We provide evidence for the movement of the AFR15 lineage into new African Union Member States and confirm previously observed differences in V. cholerae transmission dynamics in West versus East Africa, though cross-border transmission is prevalent on both sides of the continent. Despite observed differences, evolutionary processes are similar across lineages and we find no evidence for significant changes in antimicrobial resistance genotypes. Overall, our findings emphasize the importance of regionally coordinated cross-border surveillance and interventions, while also demonstrating the critical role of locally generated genomic data in understanding the spread of cholera in Africa.},
	language = {en},
	urldate = {2026-02-21},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Mboowa, Gerald and Matteson, Nathaniel Lucero and Tanui, Collins Kipngetich and Kasonde, Mpanga and Kamwiziku, Guyguy Kusanzangana and Akanbi, Olusola Anuoluwapo and Chitio, Jucunú Johane Elias and Kagoli, Mathews and Essomba, René Ghislain and Ayitewala, Alisen and Ssewanyana, Isaac and Ngo Bitoungui, Valentina Josiane and Amuri, Adrienne Aziza and Azman, Andrew S. and Babatunde, Olajumoke Atinuke and Akenji, Blaise Mboringong and Broban, Anaïs and Malembaka, Espoir Bwenge and Ongole, Francis and Chukwu, Chimaobi Emmanuel and Ismael, Nália and Kapona, Otridah and Laurindo, Osvaldo and Mbala, Placide Kingebeni and Etoundi Mballa, Georges Alain and Miambo, Imelda Carlos Zulfa and Mwanyongo, Alex Ansaye and Najjuka, Grace and Mutale, Joseph and Musonda, Kunda and Niyonzima, Allan Muruta and Nyenje, Mirriam Ethel and Popoola, Michael and Shempela, Doreen Mainza and Sike, Christiane Medi and Sitoe, Sofião Manjor and Wanjohi, Dorcas Waruguru and Welo, Placide Okitayemba and Yelewa, Mtisunge and Yennan, Sebastian and Ziba, Lucius and Bitilinyu-Bangoh, Joseph Ephram and Chilengi, Roma and Hadja, Hamsatou and Idris, Jide and Langa, José Paulo Maurício and Mukadi-Bamuleka, Daniel and Nabadda, Susan and Debes, Amanda K. and Sack, David A. and Tebeje, Yenew Kebede and Wohl, Shirlee and Tessema, Sofonias Kifle},
